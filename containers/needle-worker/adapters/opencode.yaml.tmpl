# NEEDLE adapter — opencode against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# Provider wiring lives in ~/.config/opencode/opencode.json, written by
# render.py with "apiKey": "{env:...}" indirection.

name: @@ADAPTER_NAME@@
description: opencode driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: opencode
version_command: "opencode --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && @@OPENAI_ENV@@ opencode run --model @@PROVIDER@@/@@MODEL@@ < {prompt_file}"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
