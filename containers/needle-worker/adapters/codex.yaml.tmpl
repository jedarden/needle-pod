# NEEDLE adapter — Codex against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# Rendered by needle-pod at container start. Do not edit in-pod.
#
# Codex reads its provider table from ~/.codex/config.toml, which render.py
# writes with `env_key = "@@TOKEN_VAR@@"` — so Codex resolves the token from the
# environment itself and nothing here carries a credential.
#
# The package is @openai/codex (scoped). The unscoped `codex` on npm is an
# unrelated 2012 tool.

name: @@ADAPTER_NAME@@
description: Codex driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
version: "1.0"

runner: codex
provider: @@PROVIDER@@
model: @@MODEL@@

# `codex exec` is the non-interactive mode. --skip-git-repo-check keeps it from
# refusing to run in a workspace that is not a git repo (canary dirs, scratch).
# Sandboxing is off because the pod *is* the sandbox.
invoke: |
  cd ${WORKSPACE} && \
  CODEX_DISABLE_UPDATE_CHECK=1 \
  codex exec \
        --model @@MODEL@@ \
        --skip-git-repo-check \
        --dangerously-bypass-approvals-and-sandbox \
  <<'NEEDLE_PROMPT'
  ${PROMPT}
  NEEDLE_PROMPT

input:
  method: heredoc

output:
  format: text
  success_codes: [0]
  retry_codes: [1]
  fail_codes: [2, 137]

limits:
  requests_per_minute: 60
  max_concurrent: 2
