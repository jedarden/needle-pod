# NEEDLE adapter — Codex against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# Codex resolves its provider table from ~/.codex/config.toml (written by
# render.py with env_key indirection), so no credential appears here.
#
# CAVEAT: codex 0.147 accepts only wire_api = "responses", meaning it needs an
# endpoint implementing OpenAI's Responses API. Most BYOK/subscription
# gateways do not provide one, so this adapter may be unusable depending on the
# provider — render.py warns at start when that is the case.

name: @@ADAPTER_NAME@@
description: Codex driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: codex
version_command: "codex --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && CODEX_DISABLE_UPDATE_CHECK=1 @@OPENAI_ENV@@ codex exec --model @@MODEL@@ --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox < {prompt_file}"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
output_transform: needle-transform-codex
