# NEEDLE adapter — droid (Factory CLI) against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# Provider wiring lives in ~/.factory/settings.json, written by render.py with
# "apiKey": "${...}" indirection. settings.json is used rather than the legacy
# config.json because only settings.json expands ${VAR}.
#
# `--auto high` is required: droid exec defaults to read-only tiered autonomy,
# which cannot edit files or run builds.

name: @@ADAPTER_NAME@@
description: droid driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: droid
version_command: "droid --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && droid exec --model @@MODEL@@ --auto high < {prompt_file}"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
