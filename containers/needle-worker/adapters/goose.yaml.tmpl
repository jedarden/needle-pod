# NEEDLE adapter — goose against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# GOOSE_DISABLE_KEYRING is mandatory in a pod: goose otherwise tries to reach a
# D-Bus keyring that does not exist. Only whether the variable is set matters.

name: @@ADAPTER_NAME@@
description: goose driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: goose
version_command: "goose --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && GOOSE_DISABLE_KEYRING=1 GOOSE_PROVIDER='@@PROVIDER@@' GOOSE_MODEL='@@MODEL@@' @@ANTHROPIC_ENV@@ @@OPENAI_ENV@@ goose run --no-session --instructions {prompt_file}"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
