# NEEDLE adapter — aider against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# --no-auto-commits is not optional: NEEDLE owns the commit boundary, and aider
# committing on its own would race the worker's own git handling.

name: @@ADAPTER_NAME@@
description: aider driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: aider
version_command: "aider --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && @@ANTHROPIC_ENV@@ @@OPENAI_ENV@@ aider --message-file {prompt_file} --yes-always --no-pretty --no-auto-commits --no-analytics --no-check-update --no-show-model-warnings"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
