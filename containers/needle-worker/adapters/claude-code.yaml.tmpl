# NEEDLE adapter — Claude Code against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# Rendered by needle-pod at container start. Do not edit in-pod.
#
# FORMAT NOTE: the field names here are the ones NEEDLE's AgentAdapter struct
# actually deserialises — `agent_cli` and `invoke_template`, not `runner` and
# `invoke`. The `runner:`/`invoke:` shape found in ~/.needle/agents on the
# bare-metal box is a vestigial format that nothing reads; an adapter written
# that way fails to load and the worker dies at dispatch with "configured
# agent adapter not found" AFTER it has already claimed a bead.
#
# Placeholders are {workspace}, {prompt_file}, {bead_id}, {model} (NEEDLE's) and
# the doubled-at form (needle-pod's, substituted at container start).
#
# The token is referenced as $@@TOKEN_VAR@@ and expanded by the shell at invoke
# time from the pod's Secret-backed environment — no credential on disk.

name: @@ADAPTER_NAME@@
description: Claude Code driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: claude
version_command: "claude --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && git rev-parse HEAD > .needle-predispatch-sha 2>/dev/null; unset CLAUDECODE; @@ANTHROPIC_ENV@@ claude --print --verbose --output-format stream-json --include-partial-messages --model @@MODEL@@ --dangerously-skip-permissions < {prompt_file} | cat"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
token_extraction:
  method: json_field
  input_path: "result.usage.input_tokens"
  output_path: "result.usage.output_tokens"
output_transform: needle-transform-claude
