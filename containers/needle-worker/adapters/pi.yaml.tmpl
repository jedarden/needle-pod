# NEEDLE adapter — pi against @@PROVIDER_DISPLAY@@ (@@MODEL@@)
#
# pi reads conventional provider env vars (its own containerization guide passes
# ANTHROPIC_API_KEY straight through). Package is
# @earendil-works/pi-coding-agent — NOT @mariozechner/pi, an unrelated vLLM
# pod manager whose binary is `pi-pods`.

name: @@ADAPTER_NAME@@
description: pi driving @@PROVIDER_DISPLAY@@ @@MODEL@@ (needle-pod)
agent_cli: pi
version_command: "pi --version"
input_method:
  method: stdin
invoke_template: "cd {workspace} && @@ANTHROPIC_ENV@@ @@OPENAI_ENV@@ pi -p --model @@MODEL@@ < {prompt_file}"
environment: {}
timeout_secs: @@TIMEOUT_SECS@@
provider: @@PROVIDER@@
model: @@MODEL@@
